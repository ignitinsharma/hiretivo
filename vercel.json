{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "develop": true,
      "staging": true,
      "main": true
    },
    "autoJobCancelation": true
  },
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/cron/match",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/stale-jobs",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/job-match-notification",
      "schedule": "0 9 * * *"
    }
  ]
}
