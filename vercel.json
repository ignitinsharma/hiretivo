{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "develop": true,
      "staging": true,
      "main": true
    },
    "autoJobCancelation": true
  },
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/ats-job-fetch",
      "schedule": "0 */6 * * *"
    }
  ]
}
