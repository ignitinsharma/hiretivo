{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "develop": true,
      "staging": true,
      "main": true
    },
    "autoJobCancelation": true
  },
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/cron/ats-fetch/ashby-lever",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/ats-fetch/greenhouse",
      "schedule": "15 9 * * *"
    }
  ]
}
