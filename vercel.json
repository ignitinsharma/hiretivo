{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "develop": true,
      "staging": true,
      "main": true
    },
    "autoJobCancelation": true
  },
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/ats-ashby",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/ats-greenhouse",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/ats-lever",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/ats-cleanup",
      "schedule": "0 3 * * 0"
    }
  ]
}
