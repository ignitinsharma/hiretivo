{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true,
      "develop": true
    }
  },
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/cron/match",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/stale-jobs",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/seeker-digest",
      "schedule": "0 8 * * 1"
    }
  ]
}
