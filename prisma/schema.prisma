// Hiretivo — PostgreSQL (Neon) + Prisma
// Auth.js adapter models: Account, Session, VerificationToken

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SEEKER
  RECRUITER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplyType {
  INTERNAL
  EXTERNAL
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  UNPUBLISHED
  DELETED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AppStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum SeekingStatus {
  ACTIVELY_LOOKING
  OPEN_TO_OFFERS
  NOT_LOOKING
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role              Role      @default(SEEKER)
  plan              PlanTier  @default(FREE)
  billingCustomerId String?
  timezone          String?
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int?
  onboardingDraft     Json?
  isAdmin              Boolean  @default(false)
  verificationStatus   VerificationStatus @default(NOT_SUBMITTED)
  seekingStatus        SeekingStatus      @default(OPEN_TO_OFFERS)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  seekerProfile   SeekerProfile?
  recruiterProfile RecruiterProfile?

  jobsPosted Job[] @relation("RecruiterJobs")

  applications Application[]

  interviewsAsRecruiter Interview[] @relation("InterviewRecruiter")
  interviewsAsSeeker    Interview[] @relation("InterviewSeeker")

  clickEvents ClickEvent[]

  boostedJobs BoostedJob[] @relation("BoostedJobs")
  savedJobs            SavedJob[]
  dismissedJobs        DismissedJob[]
  subscription         Subscription?
  verificationReviews  VerificationReview[]
  engineerUnlocksAsRecruiter EngineerUnlock[] @relation("RecruiterUnlocks")
  engineerUnlocksAsEngineer  EngineerUnlock[] @relation("EngineerUnlocks")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeekerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline       String?
  bio            String?  @db.Text
  location       String?
  yearsExperience Int?
  workPreference WorkType?

  situation       String?
  primaryRole     String?
  salaryMin       Int?
  salaryMax       Int?
  currency        String?
  availability    String?
  resumeKey       String?

  websiteUrl      String?
  linkedinUrl     String?
  githubUrl       String?
  twitterUrl      String?

  githubUsername         String?
  videoIntroUrl          String?
  topProjects            Json?
  salaryMinUsd           Int?
  salaryMaxUsd           Int?
  verificationNotes      String?   @db.Text
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  submittedForReviewAt   DateTime?

  digestEnabled    Boolean   @default(true)
  lastDigestSentAt DateTime?

  skills          SeekerSkill[]
  jobMatches      JobMatch[]
  workExperiences WorkExperience[]
  educations      Education[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  slug     String @unique
  category String

  seekerSkills SeekerSkill[]
  jobSkills    JobSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeekerSkill {
  id              String @id @default(cuid())
  seekerProfileId String
  skillId         String
  level           SkillLevel

  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([seekerProfileId, skillId])
  @@index([skillId])
}

model RecruiterProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  website     String?
  bio         String? @db.Text
  companySize String?
  industry    String?
  fundingType String?
  isFullyRemote Boolean  @default(false)
  logo        String?

  emailNotifications     Boolean @default(true)
  applicationAlerts      Boolean @default(true)
  interviewNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String @id @default(cuid())
  recruiterId String
  recruiter   User   @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: Cascade)

  title       String
  description String      @db.Text
  jobType     JobType
  applyType   ApplyType
  workType    WorkType?
  status      JobStatus   @default(DRAFT)

  salaryMin Int?
  salaryMax Int?
  currency  String?

  experienceLevel String?
  category        String?

  externalApplyUrl String?

  // Admin-posted job company overrides — null on regular recruiter jobs.
  // When non-null, take precedence over the recruiter's profile for display.
  companyName     String?
  companyLogoUrl  String?
  companyWebsite  String?
  companySize     String?
  companyIndustry String?
  companyFunding  String?
  isAdminPosted   Boolean   @default(false)

  publishedAt DateTime?
  closedAt    DateTime?

  // ATS job feed fields — null on regular recruiter jobs
  atsSource       String?   // 'ashby' | 'greenhouse' | 'lever'
  atsSourceId     String?   // Raw ID from source API (stable per source)
  descriptionHash String?   @map("description_hash")
  dedupeKey       String?   @unique  // MD5(companyName|title|atsSourceId)
  lastSeenAt      DateTime? // Refreshed every cron run — drives 48h stale check
  location        String?   // Raw location string: "San Francisco, CA", "Remote", "Bangalore, India"
  locationClass   String?   // Classified: 'worldwide' | 'us-only' | 'emea' | 'india' | 'onsite'
  visaSponsored   Boolean   @default(false)  // Extracted from description text

  skills        JobSkill[]
  applications  Application[]
  jobMatches    JobMatch[]
  clickEvents   ClickEvent[]
  boostedJob    BoostedJob?
  savedBy       SavedJob[]
  dismissedBy   DismissedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recruiterId])
  @@index([status])
  @@index([createdAt])
  @@index([isAdminPosted])
  @@index([status, createdAt])
  @@index([atsSource])
  @@index([locationClass])
  @@index([lastSeenAt])
  @@index([companyName, status])
}

model AtsBlocklist {
  id          String   @id @default(cuid())
  companyName String   // Match against Job.companyName (case-insensitive)
  domain      String?  // Match against Job.companyWebsite (optional)
  reason      String?  // Admin note
  blockedAt   DateTime @default(now())
  blockedBy   String?  // Admin userId who added this

  @@index([companyName])
  @@index([domain])
}

model JobSkill {
  id      String @id @default(cuid())
  jobId   String
  skillId String
  level   SkillLevel

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}

model JobMatch {
  id              String @id @default(cuid())
  jobId           String
  seekerProfileId String
  score           Int

  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  computedAt DateTime @default(now())

  @@unique([jobId, seekerProfileId])
  @@index([seekerProfileId])
  @@index([score])
}

model Application {
  id String @id @default(cuid())

  jobId    String
  seekerId String

  status      AppStatus @default(APPLIED)
  matchScore  Int

  coverLetter String? @db.Text
  aiSummary   String? // INT-01: lazy-cached AI candidate summary; null = not yet generated

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker User @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  interviews Interview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, seekerId])
  @@index([seekerId])
  @@index([status])
  @@index([jobId, status])
}

model Interview {
  id String @id @default(cuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  recruiterId String
  recruiter   User   @relation("InterviewRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)

  seekerId String
  seeker   User   @relation("InterviewSeeker", fields: [seekerId], references: [id], onDelete: Cascade)

  status   InterviewStatus @default(SCHEDULED)
  startsAt DateTime?
  endsAt   DateTime?
  meetLink String?
  notes             String? @db.Text
  scheduledTimeZone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([recruiterId])
  @@index([seekerId])
  @@index([startsAt])
}

model ClickEvent {
  id String @id @default(cuid())

  jobId  String?
  job    Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  source   String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([userId])
  @@index([createdAt])
}

model EarlyAccessEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model BoostedJob {
  id          String   @id @default(cuid())
  jobId       String   @unique
  recruiterId String
  paymentId   String?
  startsAt    DateTime @default(now())
  expiresAt   DateTime

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiter User @relation("BoostedJobs", fields: [recruiterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([recruiterId])
}

model Subscription {
  id                 String    @id @default(cuid())
  dodoSubscriptionId String    @unique
  productId          String
  status             SubStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  scheduledPlan      PlanTier?
  scheduledChangeAt  DateTime?
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([dodoSubscriptionId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model DismissedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model WorkExperience {
  id              String        @id @default(cuid())
  seekerProfileId String
  seekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  company      String
  title        String
  startDate    String       // "MM/YYYY" — freeform display date, not a DateTime
  endDate      String?      // "MM/YYYY" — null means currently working here
  isCurrent    Boolean  @default(false)
  description  String?  @db.Text
  positionType String?      // "technical" | "non-technical" — validated at Zod layer, not a Prisma enum
  skills       String[]     // denormalized skill name tags; not FK to Skill table

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seekerProfileId])
}

model Education {
  id              String        @id @default(cuid())
  seekerProfileId String
  seekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  institution    String
  graduationDate String?      // "MM/YYYY" — freeform display date, not a DateTime
  degree         String?
  major          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seekerProfileId])
}

model VerificationReview {
  id         String             @id @default(cuid())
  userId     String
  reviewedBy String?
  status     VerificationStatus
  scoreGiven Int?
  notes      Json?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model EngineerUnlock {
  id          String   @id @default(cuid())
  recruiterId String
  engineerId  String
  // "talent_pool" = counts against quota | "application_auto" = free, never counted
  source      String   @default("talent_pool")
  createdAt   DateTime @default(now())

  recruiter User @relation("RecruiterUnlocks", fields: [recruiterId], references: [id], onDelete: Cascade)
  engineer  User @relation("EngineerUnlocks", fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, engineerId])
  @@index([recruiterId])
  @@index([engineerId])
  @@index([source])
  @@index([createdAt])
}
