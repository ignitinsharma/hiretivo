generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Application {
  id          String      @id
  jobId       String
  seekerId    String
  status      AppStatus   @default(APPLIED)
  matchScore  Int
  coverLetter String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  aiSummary   String?
  Job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  User        User        @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  Interview   Interview[]

  @@unique([jobId, seekerId])
  @@index([jobId, status])
  @@index([seekerId])
  @@index([status])
}

model BoostedJob {
  id          String   @id
  jobId       String   @unique
  recruiterId String
  paymentId   String?
  startsAt    DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  Job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([recruiterId])
}

model ClickEvent {
  id        String   @id
  jobId     String?
  userId    String?
  source    String
  metadata  Json?
  createdAt DateTime @default(now())
  Job       Job?     @relation(fields: [jobId], references: [id])
  User      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([jobId])
  @@index([userId])
}

model DismissedJob {
  id        String   @id
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  Job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId])
}

model EarlyAccessEmail {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())
}

model Education {
  id              String        @id
  seekerProfileId String
  institution     String
  graduationDate  String?
  degree          String?
  major           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  SeekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  @@index([seekerProfileId])
}

model EngineerUnlock {
  id                                    String   @id
  recruiterId                           String
  engineerId                            String
  source                                String   @default("talent_pool")
  createdAt                             DateTime @default(now())
  User_EngineerUnlock_engineerIdToUser  User     @relation("EngineerUnlock_engineerIdToUser", fields: [engineerId], references: [id], onDelete: Cascade)
  User_EngineerUnlock_recruiterIdToUser User     @relation("EngineerUnlock_recruiterIdToUser", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, engineerId])
  @@index([createdAt])
  @@index([engineerId])
  @@index([recruiterId])
  @@index([source])
}

model Interview {
  id                               String          @id
  applicationId                    String
  recruiterId                      String
  seekerId                         String
  status                           InterviewStatus @default(SCHEDULED)
  startsAt                         DateTime?
  endsAt                           DateTime?
  meetLink                         String?
  notes                            String?
  createdAt                        DateTime        @default(now())
  updatedAt                        DateTime
  scheduledTimeZone                String?
  Application                      Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  User_Interview_recruiterIdToUser User            @relation("Interview_recruiterIdToUser", fields: [recruiterId], references: [id], onDelete: Cascade)
  User_Interview_seekerIdToUser    User            @relation("Interview_seekerIdToUser", fields: [seekerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([recruiterId])
  @@index([seekerId])
  @@index([startsAt])
}

model Job {
  id               String         @id
  recruiterId      String
  title            String
  description      String
  jobType          JobType
  applyType        ApplyType
  workType         WorkType?
  status           JobStatus      @default(DRAFT)
  salaryMin        Int?
  salaryMax        Int?
  currency         String?
  externalApplyUrl String?
  publishedAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  category         String?
  companyName      String?
  companyLogoUrl   String?
  companyWebsite   String?
  companySize      String?
  companyIndustry  String?
  companyFunding   String?
  isAdminPosted    Boolean        @default(false)
  experienceLevel  String?
  Application      Application[]
  BoostedJob       BoostedJob?
  ClickEvent       ClickEvent[]
  DismissedJob     DismissedJob[]
  User             User           @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  JobMatch         JobMatch[]
  JobSkill         JobSkill[]
  SavedJob         SavedJob[]

  @@index([createdAt])
  @@index([isAdminPosted])
  @@index([recruiterId])
  @@index([status, createdAt])
  @@index([status])
}

model JobMatch {
  id              String        @id
  jobId           String
  seekerProfileId String
  score           Int
  computedAt      DateTime      @default(now())
  Job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  SeekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  @@unique([jobId, seekerProfileId])
  @@index([score])
  @@index([seekerProfileId])
}

model JobSkill {
  id      String     @id
  jobId   String
  skillId String
  level   SkillLevel
  Job     Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  Skill   Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}

model RecruiterProfile {
  id                     String   @id
  userId                 String   @unique
  companyName            String
  website                String?
  bio                    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  companySize            String?
  industry               String?
  fundingType            String?
  isFullyRemote          Boolean  @default(false)
  logo                   String?
  applicationAlerts      Boolean  @default(true)
  emailNotifications     Boolean  @default(true)
  interviewNotifications Boolean  @default(true)
  User                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedJob {
  id        String   @id
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  Job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId])
}

model SeekerProfile {
  id                     String           @id
  userId                 String           @unique
  headline               String?
  bio                    String?
  location               String?
  yearsExperience        Int?
  workPreference         WorkType?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime
  situation              String?
  salaryMin              Int?
  salaryMax              Int?
  currency               String?
  availability           String?
  primaryRole            String?
  resumeKey              String?
  digestEnabled          Boolean          @default(false)
  githubUrl              String?
  linkedinUrl            String?
  twitterUrl             String?
  websiteUrl             String?
  githubUsername         String?
  salaryMaxUsd           Int?
  salaryMinUsd           Int?
  submittedForReviewAt   DateTime?
  topProjects            Json?
  verificationNotes      String?
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  videoIntroUrl          String?
  Education              Education[]
  JobMatch               JobMatch[]
  User                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  SeekerSkill            SeekerSkill[]
  WorkExperience         WorkExperience[]
}

model SeekerSkill {
  id              String        @id
  seekerProfileId String
  skillId         String
  level           SkillLevel
  SeekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  Skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([seekerProfileId, skillId])
  @@index([skillId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Skill {
  id          String        @id
  name        String        @unique
  slug        String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  category    String
  JobSkill    JobSkill[]
  SeekerSkill SeekerSkill[]
}

model Subscription {
  id                 String    @id
  dodoSubscriptionId String    @unique
  productId          String
  status             SubStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  scheduledPlan      PlanTier?
  scheduledChangeAt  DateTime?
  userId             String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  User               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dodoSubscriptionId])
  @@index([userId])
}

model User {
  id                                              String               @id
  name                                            String?
  email                                           String?              @unique
  emailVerified                                   DateTime?
  image                                           String?
  passwordHash                                    String?
  role                                            Role                 @default(SEEKER)
  plan                                            PlanTier             @default(FREE)
  createdAt                                       DateTime             @default(now())
  updatedAt                                       DateTime
  billingCustomerId                               String?
  timezone                                        String?
  onboardingCompleted                             Boolean              @default(false)
  onboardingStep                                  Int?
  onboardingDraft                                 Json?
  seekingStatus                                   SeekingStatus        @default(OPEN_TO_OFFERS)
  verificationStatus                              VerificationStatus   @default(NOT_SUBMITTED)
  Account                                         Account[]
  Application                                     Application[]
  BoostedJob                                      BoostedJob[]
  ClickEvent                                      ClickEvent[]
  DismissedJob                                    DismissedJob[]
  EngineerUnlock_EngineerUnlock_engineerIdToUser  EngineerUnlock[]     @relation("EngineerUnlock_engineerIdToUser")
  EngineerUnlock_EngineerUnlock_recruiterIdToUser EngineerUnlock[]     @relation("EngineerUnlock_recruiterIdToUser")
  Interview_Interview_recruiterIdToUser           Interview[]          @relation("Interview_recruiterIdToUser")
  Interview_Interview_seekerIdToUser              Interview[]          @relation("Interview_seekerIdToUser")
  Job                                             Job[]
  RecruiterProfile                                RecruiterProfile?
  SavedJob                                        SavedJob[]
  SeekerProfile                                   SeekerProfile?
  Session                                         Session[]
  Subscription                                    Subscription?
  VerificationReview                              VerificationReview[]
}

model VerificationReview {
  id         String             @id
  userId     String
  reviewedBy String?
  status     VerificationStatus
  scoreGiven Int?
  notes      Json?
  createdAt  DateTime           @default(now())
  User       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WorkExperience {
  id              String        @id
  seekerProfileId String
  company         String
  title           String
  startDate       String
  endDate         String?
  isCurrent       Boolean       @default(false)
  description     String?
  positionType    String?
  skills          String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  SeekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  @@index([seekerProfileId])
}

enum AppStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ApplyType {
  INTERNAL
  EXTERNAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum JobStatus {
  OPEN
  UNPUBLISHED
  DELETED
  DRAFT
  PAUSED
  CLOSED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum Role {
  SEEKER
  RECRUITER
}

enum SeekingStatus {
  ACTIVELY_LOOKING
  OPEN_TO_OFFERS
  NOT_LOOKING
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}
