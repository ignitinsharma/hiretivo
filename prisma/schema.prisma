// Hiretivo — PostgreSQL (Neon) + Prisma
// Auth.js adapter models: Account, Session, VerificationToken

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SEEKER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplyType {
  INTERNAL
  EXTERNAL
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  UNPUBLISHED
  DELETED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AppStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum AutomationStatus {
  GENERATING
  READY
  APPLYING
  SUBMITTED
  NEEDS_YOU
  FAILED
  COMPLETED
  SKIPPED
}

enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}

enum PlanTier {
  FREE
  PRO
  UNLIMITED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum SeekingStatus {
  ACTIVELY_LOOKING
  OPEN_TO_OFFERS
  NOT_LOOKING
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PipelineStage {
  NOT_APPLIED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

enum CalendarEventKind {
  INTERVIEW
  DEADLINE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  passwordChangedAt DateTime?
  role              Role      @default(SEEKER)
  plan              PlanTier  @default(FREE)
  billingCustomerId String?
  timezone          String?
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int?
  onboardingDraft     Json?
  isAdmin              Boolean  @default(false)
  verificationStatus   VerificationStatus @default(NOT_SUBMITTED)
  seekingStatus        SeekingStatus      @default(OPEN_TO_OFFERS)
  lastActiveAt         DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  seekerProfile    SeekerProfile?
  applications     Application[]
  masterResume     MasterResume?
  generationQuotas GenerationQuota[]
  clickEvents      ClickEvent[]
  savedJobs        SavedJob[]
  dismissedJobs    DismissedJob[]
  subscription     Subscription?
  verificationReviews VerificationReview[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeekerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline       String?
  bio            String?  @db.Text
  location       String?
  yearsExperience Int?
  workPreference WorkType?

  situation       String?
  primaryRole     String?
  salaryMin       Int?
  salaryMax       Int?
  currency        String?
  availability    String?
  resumeKey       String?
  phone           String?

  websiteUrl      String?
  linkedinUrl     String?
  githubUrl       String?
  twitterUrl      String?

  githubUsername         String?
  videoIntroUrl          String?
  topProjects            Json?
  salaryMinUsd           Int?
  salaryMaxUsd           Int?
  verificationNotes      String?   @db.Text
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  submittedForReviewAt   DateTime?

  digestEnabled    Boolean   @default(true)
  lastDigestSentAt DateTime?

  skills          SeekerSkill[]
  jobMatches      JobMatch[]
  workExperiences WorkExperience[]
  educations      Education[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  slug     String @unique
  category String
  aliases  String[] @default([])

  seekerSkills SeekerSkill[]
  jobSkills    JobSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeekerSkill {
  id              String @id @default(cuid())
  seekerProfileId String
  skillId         String
  level           SkillLevel

  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([seekerProfileId, skillId])
  @@index([skillId])
}

model Job {
  id          String @id @default(cuid())

  title       String
  description String      @db.Text
  jobType     JobType
  applyType   ApplyType
  workType    WorkType?
  status      JobStatus   @default(DRAFT)

  salaryMin Int?
  salaryMax Int?
  currency  String?

  experienceLevel String?
  category        String?

  externalApplyUrl String?

  // Company info — populated from ATS feed or admin post
  companyName     String?
  companyLogoUrl  String?
  companyWebsite  String?
  companySize     String?
  companyIndustry String?
  companyFunding  String?

  publishedAt DateTime?
  closedAt    DateTime?

  // ATS job feed fields
  atsSource       String?   // 'ashby' | 'greenhouse' | 'lever'
  atsSourceId     String?   // Raw ID from source API (stable per source)
  descriptionHash String?   @map("description_hash")
  dedupeKey       String?   @unique  // MD5(companyName|title|atsSourceId)
  lastSeenAt      DateTime? // Refreshed every cron run — drives 48h stale check
  location        String?   // Raw location string: "San Francisco, CA", "Remote", "Bangalore, India"
  locationClass   String?   // Classified: 'worldwide' | 'us-only' | 'emea' | 'india' | 'onsite'
  visaSponsored   Boolean   @default(false)  // Extracted from description text

  // Manual tracking — jobs added by a seeker in the tracker, never public
  isManual Boolean  @default(false)
  ownerId  String?  // Seeker userId who created this manual job

  skills        JobSkill[]
  applications  Application[]
  jobMatches    JobMatch[]
  clickEvents   ClickEvent[]
  savedBy       SavedJob[]
  dismissedBy   DismissedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([atsSource])
  @@index([locationClass])
  @@index([lastSeenAt])
  @@index([companyName, status])
  @@index([ownerId])
}

model AtsBlocklist {
  id          String   @id @default(cuid())
  companyName String   // Match against Job.companyName (case-insensitive)
  domain      String?  // Match against Job.companyWebsite (optional)
  reason      String?  // Admin note
  blockedAt   DateTime @default(now())
  blockedBy   String?  // Admin userId who added this

  @@index([companyName])
  @@index([domain])
}

model JobSkill {
  id      String @id @default(cuid())
  jobId   String
  skillId String
  level   SkillLevel

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}

model JobMatch {
  id              String @id @default(cuid())
  jobId           String
  seekerProfileId String
  score           Int

  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  computedAt DateTime @default(now())

  @@unique([jobId, seekerProfileId])
  @@index([seekerProfileId])
  @@index([score])
}

model Application {
  id String @id @default(cuid())

  jobId    String
  seekerId String

  status      AppStatus @default(APPLIED)
  matchScore  Int

  automationStatus AutomationStatus? @map("automation_status")
  failureReason    String?               @map("failure_reason")
  automationRunId  String?               @map("automation_run_id")
  generationStartedAt DateTime?          @map("generation_started_at")

  pipelineStage PipelineStage @default(NOT_APPLIED) @map("pipeline_stage")
  furthestPipelineStage PipelineStage @default(NOT_APPLIED) @map("furthest_pipeline_stage")

  coverLetter String? @db.Text
  aiSummary   String?

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker User @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  resumeVersions ResumeVersion[]
  coverLetters   CoverLetter[]
  calendarEvents CalendarEvent[]

  generationCount Int    @default(0)
  activeVersionId String?

  appliedAt DateTime? @map("applied_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, seekerId])
  @@index([seekerId])
  @@index([status])
  @@index([jobId, status])
  @@index([activeVersionId])
  @@index([pipelineStage])
  @@index([automationRunId])
}

model CalendarEvent {
  id            String            @id @default(cuid())
  applicationId String
  kind          CalendarEventKind
  title         String
  startsAt      DateTime
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([startsAt])
}

// MasterResume — canonical, document-only storage for the user's uploaded/parsed base resume.
// This is the ONE source of truth — normalized tables (WorkExperience, Education,
// SeekerSkill, etc.) are derived read-only caches, written ONLY by a
// sync-from-MasterResume transaction, never directly by any other code path.
model MasterResume {
  id         String   @id @default(cuid())
  userId     String   @unique
  resumeJson Json     // Phase 0 schema JSON — canonical source of truth
  styleConfig Json?   // selected theme and presentation for the base resume
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// GenerationQuota — tracks monthly generation usage per user, enforced server-side
model GenerationQuota {
  id        String   @id @default(cuid())
  userId    String
  month     String   // "YYYY-MM"
  type      String   @default("RESUME") // "RESUME" | "COVER_LETTER"
  count     Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, type])
  @@index([userId])
}

// ResumeVersion — each generate/regenerate creates a new version row, no silent overwrite
model ResumeVersion {
  id            String   @id @default(cuid())
  applicationId String
  version       Int      @default(1)
  resumeJson    Json
  sourceType    String   @default("ai-generated") // ai-generated | regenerate | manual-edit
  styleConfig   Json?
  createdAt     DateTime @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// CoverLetter — per-application cover letter storage
model CoverLetter {
  id            String   @id @default(cuid())
  applicationId String
  content       String   // generated cover letter text
  createdAt     DateTime @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ClickEvent {
  id String @id @default(cuid())

  jobId  String?
  job    Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  source   String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([userId])
  @@index([createdAt])
}

model EarlyAccessEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id                 String    @id @default(cuid())
  dodoSubscriptionId String    @unique
  productId          String
  status             SubStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  scheduledPlan      PlanTier?
  scheduledChangeAt  DateTime?
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([dodoSubscriptionId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model DismissedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model WorkExperience {
  id              String        @id @default(cuid())
  seekerProfileId String
  seekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  company      String
  title        String
  startDate    String       // "MM/YYYY" — freeform display date, not a DateTime
  endDate      String?      // "MM/YYYY" — null means currently working here
  isCurrent    Boolean  @default(false)
  description  String?  @db.Text
  positionType String?      // "technical" | "non-technical" — validated at Zod layer, not a Prisma enum
  skills       String[]     // denormalized skill name tags; not FK to Skill table

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seekerProfileId])
}

model Education {
  id              String        @id @default(cuid())
  seekerProfileId String
  seekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  institution    String
  graduationDate String?      // "MM/YYYY" — freeform display date, not a DateTime
  degree         String?
  major          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seekerProfileId])
}

model VerificationReview {
  id         String             @id @default(cuid())
  userId     String
  reviewedBy String?
  status     VerificationStatus
  scoreGiven Int?
  notes      Json?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Key-value store for global admin-controlled flags.
// key is unique — upsert by key to read/write.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
