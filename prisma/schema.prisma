// Hiretivo — PostgreSQL (Neon) + Prisma
// Auth.js adapter models: Account, Session, VerificationToken

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SEEKER
  RECRUITER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplyType {
  INTERNAL
  EXTERNAL
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  UNPUBLISHED
  DELETED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AppStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum ApplicationSource {
  SEEKER_APPLIED
  RECRUITER_INITIATED
}

enum ContractType {
  FULL_TIME
  CONTRACT
  PART_TIME
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role              Role      @default(SEEKER)
  plan              PlanTier  @default(FREE)
  billingCustomerId String?
  timezone          String?
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int?
  onboardingDraft     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  seekerProfile   SeekerProfile?
  recruiterProfile RecruiterProfile?

  jobsPosted Job[] @relation("RecruiterJobs")

  applications Application[]

  interviewsAsRecruiter Interview[] @relation("InterviewRecruiter")
  interviewsAsSeeker    Interview[] @relation("InterviewSeeker")

  clickEvents ClickEvent[]

  subscription         Subscription?
  verificationStatus    VerificationStatus @default(NOT_SUBMITTED)
  hiretivoScore         Int?
  scoreUpdatedAt        DateTime?
  timezoneOverlapHours  Int?
  availableFrom         DateTime?
  reapplyAfter          DateTime?
  profileSlug           String? @unique
  hiddenUntil           DateTime?

  verificationReviews   VerificationReview[]
  unlocksGiven          EngineerUnlock[]   @relation("RecruiterUnlocks")
  unlocksReceived       EngineerUnlock[]   @relation("EngineerUnlocks")
  feedbackReceived      EmployerFeedback[] @relation("FeedbackReceived")
  feedbackGiven         EmployerFeedback[] @relation("FeedbackGiven")
  savedByRecruiters     SavedEngineer[]    @relation("SavedEngineer")
  savedEngineers        SavedEngineer[]    @relation("SavedByRecruiter")
  blockedRecruiters     BlockedRecruiter[]
  feedbackRequests      FeedbackRequest[]  @relation("FeedbackRequests")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeekerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline       String?
  bio            String?  @db.Text
  location       String?
  yearsExperience Int?
  workPreference WorkType?

  situation       String?
  primaryRole     String?
  salaryMin       Int?
  salaryMax       Int?
  currency        String?
  availability    String?
  resumeKey       String?

  websiteUrl      String?
  linkedinUrl     String?
  githubUrl       String?
  twitterUrl      String?
  codingProfiles  Json?

  digestEnabled Boolean @default(false)
  githubUsername          String?
  githubScore             Int?
  githubAnalysis          Json?
  githubScannedAt         DateTime?
  verificationNotes       String?  @db.Text
  verificationReviewedAt  DateTime?
  verificationReviewedBy  String?
  videoIntroUrl           String?
  topProjects             Json?
  salaryMinUsd            Int?
  salaryMaxUsd            Int?
  profilePublic           Boolean @default(false)
  profilePublicConsentAt  DateTime?

  skills          SeekerSkill[]
  jobMatches      JobMatch[]
  workExperiences WorkExperience[]
  educations      Education[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  slug     String @unique
  category String

  seekerSkills SeekerSkill[]
  jobSkills    JobSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeekerSkill {
  id              String @id @default(cuid())
  seekerProfileId String
  skillId         String
  level           SkillLevel

  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([seekerProfileId, skillId])
  @@index([skillId])
}

model RecruiterProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  website     String?
  bio         String? @db.Text
  companySize String?
  industry    String?
  fundingType String?
  isFullyRemote Boolean  @default(false)
  logo        String?

  emailNotifications     Boolean @default(true)
  applicationAlerts      Boolean @default(true)
  interviewNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String @id @default(cuid())
  recruiterId String
  recruiter   User   @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: Cascade)

  title       String
  description String      @db.Text
  jobType     JobType
  applyType   ApplyType
  workType    WorkType?
  status      JobStatus   @default(DRAFT)

  salaryMin Int?
  salaryMax Int?
  currency  String?

  minYearsExperience Int?
  category           String?
  salaryMinUsd          Int?
  salaryMaxUsd          Int?
  timezoneOverlapHours  Int?
  contractType          ContractType?
  isRemoteOnly          Boolean @default(true)

  externalApplyUrl String?

  // Admin-posted job company overrides — null on regular recruiter jobs.
  // When non-null, take precedence over the recruiter's profile for display.
  companyName     String?
  companyLogoUrl  String?
  companyWebsite  String?
  companySize     String?
  companyIndustry String?
  companyFunding  String?
  isAdminPosted   Boolean   @default(false)

  publishedAt DateTime?
  closedAt    DateTime?

  skills        JobSkill[]
  applications  Application[]
  jobMatches    JobMatch[]
  clickEvents   ClickEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recruiterId])
  @@index([status])
  @@index([createdAt])
  @@index([isAdminPosted])
  @@index([status, createdAt])
}

model JobSkill {
  id      String @id @default(cuid())
  jobId   String
  skillId String
  level   SkillLevel

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}

model JobMatch {
  id              String @id @default(cuid())
  jobId           String
  seekerProfileId String
  score           Int

  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  computedAt DateTime @default(now())

  @@unique([jobId, seekerProfileId])
  @@index([seekerProfileId])
  @@index([score])
}

model Application {
  id String @id @default(cuid())

  jobId    String
  seekerId String

  status      AppStatus @default(APPLIED)
  source      ApplicationSource @default(SEEKER_APPLIED)
  matchScore  Int

  coverLetter String? @db.Text
  aiSummary   String? // INT-01: lazy-cached AI candidate summary; null = not yet generated

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker User @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  interviews Interview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, seekerId])
  @@index([seekerId])
  @@index([status])
  @@index([jobId, status])
}

model Interview {
  id String @id @default(cuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  recruiterId String
  recruiter   User   @relation("InterviewRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)

  seekerId String
  seeker   User   @relation("InterviewSeeker", fields: [seekerId], references: [id], onDelete: Cascade)

  status   InterviewStatus @default(SCHEDULED)
  startsAt DateTime?
  endsAt   DateTime?
  meetLink String?
  notes             String? @db.Text
  scheduledTimeZone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([recruiterId])
  @@index([seekerId])
  @@index([startsAt])
}

model ClickEvent {
  id String @id @default(cuid())

  jobId  String?
  job    Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  source   String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([userId])
  @@index([createdAt])
}

model EarlyAccessEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id                 String    @id @default(cuid())
  dodoSubscriptionId String    @unique
  productId          String
  status             SubStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([dodoSubscriptionId])
}

model WorkExperience {
  id              String        @id @default(cuid())
  seekerProfileId String
  seekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  company      String
  title        String
  startDate    String       // "MM/YYYY" — freeform display date, not a DateTime
  endDate      String?      // "MM/YYYY" — null means currently working here
  isCurrent    Boolean  @default(false)
  description  String?  @db.Text
  positionType String?      // "technical" | "non-technical" — validated at Zod layer, not a Prisma enum
  skills       String[]     // denormalized skill name tags; not FK to Skill table

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seekerProfileId])
}

model VerificationReview {
  id           String             @id @default(cuid())
  userId       String
  reviewedBy   String?
  status       VerificationStatus
  scoreGiven   Int?
  notes        Json?
  aiSummary    Json?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model EngineerUnlock {
  id           String   @id @default(cuid())
  recruiterId  String
  engineerId   String
  source       String
  unlockedAt   DateTime @default(now())
  recruiter    User     @relation("RecruiterUnlocks", fields: [recruiterId], references: [id], onDelete: Cascade)
  engineer     User     @relation("EngineerUnlocks", fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, engineerId])
  @@index([recruiterId])
  @@index([recruiterId, unlockedAt])
}

model EmployerFeedback {
  id                String   @id @default(cuid())
  engineerId        String
  recruiterId       String
  jobId             String?
  feedbackRequestId String   @unique
  rating            Int
  comment           String?  @db.Text
  createdAt         DateTime @default(now())
  engineer          User     @relation("FeedbackReceived", fields: [engineerId], references: [id], onDelete: Cascade)
  recruiter         User     @relation("FeedbackGiven", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([engineerId])
}

model SavedEngineer {
  id           String   @id @default(cuid())
  recruiterId  String
  engineerId   String
  createdAt    DateTime @default(now())
  recruiter    User     @relation("SavedByRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  engineer     User     @relation("SavedEngineer", fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, engineerId])
  @@index([recruiterId])
}

model BlockedRecruiter {
  id              String   @id @default(cuid())
  engineerId      String
  recruiterDomain String
  createdAt       DateTime @default(now())
  engineer        User     @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([engineerId, recruiterDomain])
  @@index([engineerId])
}

model FeedbackRequest {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  engineerId  String
  recruiterId String
  jobId       String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  engineer    User      @relation("FeedbackRequests", fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([tokenHash])
}

model Education {
  id              String        @id @default(cuid())
  seekerProfileId String
  seekerProfile   SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  institution    String
  graduationDate String?      // "MM/YYYY" — freeform display date, not a DateTime
  degree         String?
  major          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seekerProfileId])
}
