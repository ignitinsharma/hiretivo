# ============================================
# Hiretivo — Environment Variables Template
# ============================================
# Copy this to .env.local for local development
# Set these in Vercel Dashboard for deployments

# Database (Neon PostgreSQL)
# Production: Use production database connection string
# Preview: Use staging/preview database connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"

# Auth.js Secret
# Generate with: openssl rand -base64 32
# Use DIFFERENT secrets for production vs preview
AUTH_SECRET="your-secret-here"
BETTER_AUTH_SECRET="your-secret-here"

# App URL
# Production: https://hiretivo.com
# Preview: Use Vercel's auto-generated URL or set to $VERCEL_URL
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (Email)
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="Hiretivo <onboarding@resend.dev>"

# Upstash Redis (Rate limiting & caching)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Cloudflare R2 (File storage - S3 compatible)
# Get from: https://dash.cloudflare.com/
# Consider separate buckets for prod vs preview
R2_ACCOUNT_ID="your-account-id"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="hiretivo-uploads"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"

# Coming Soon Page Toggle
# Set to "true" to show coming soon page instead of home page
# Remove or set to "false" to show normal home page
NEXT_PUBLIC_SHOW_COMING_SOON=false

# AI Provider (Phase 13 — AI features)
# AI_PROVIDER: 'openrouter' (default, ~10% markup) or 'gemini' (Google direct, no markup)
# To switch to Gemini: set AI_PROVIDER=gemini, AI_MODEL=gemini-2.0-flash, fill GEMINI_API_KEY
AI_PROVIDER="openrouter"
OPENROUTER_API_KEY="your-openrouter-api-key"   # https://openrouter.ai/keys
GEMINI_API_KEY=""                               # https://aistudio.google.com/app/apikey (leave blank if using OpenRouter)
AI_MODEL="minimax/minimax-m2.5:free"            # OpenRouter: "minimax/minimax-m2.5:free" | Gemini direct: "gemini-2.0-flash"

# AI Trial — FREE users get AI access until this date (ISO 8601, UTC)
# Remove this var entirely to disable trial (FREE users blocked immediately)
# AI_TRIAL_ENDS="2026-05-19"
