# Admin Configuration
# Email address of the admin user who can access the admin job upload panel.
# Used by isAdminSession() to gate admin-only routes and UI.
ADMIN_EMAIL=

# Password used by scripts/seed-admin.ts to seed/upsert the admin account.
# Not read at runtime — only by the seed script.
ADMIN_PASSWORD=

# Sentry (optional — if unset, Sentry is a no-op and build still succeeds)
# Get DSN from https://sentry.io project settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN (same as public DSN if you only have one).
SENTRY_DSN=
# Used by withSentryConfig at build time to upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=hiretivo
SENTRY_AUTH_TOKEN=
